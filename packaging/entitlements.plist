<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Python and Qt both generate code at run time: CPython for its own
       bytecode, and Qt WebEngine's JavaScript engine as its whole job.
       Without these two the hardened runtime kills the process on
       launch, and the crash names neither of them. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- PyInstaller loads its dylibs from inside the bundle at run time,
       which library validation refuses unless every one carries the
       same team signature. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Files the user opens are the point of the application. -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
